            {
              "task": "Expect redirect uri mismatch error page",
              "match": "https://tegata.localhost:8080/authorize*",
              "commands": [["wait", "xpath", "//*", 10, "invalid client_id or redirect_uri", "update-image-placeholder"]]
            }
          ]
        }
      ]
    },
